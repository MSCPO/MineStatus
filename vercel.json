{
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "version": 2,
  "routes": [
    {
      "src": "/(.*)",
      "continue": true,
      "dest": "main.py",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET,OPTIONS",
        "Access-Control-Allow-Headers": "Accept, Content-Type"
      }
    }
  ]
}